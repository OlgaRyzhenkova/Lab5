<Window x:Class="Lab5_OOP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab5_OOP"
        mc:Ignorable="d"
        Title="Лабораторна робота 5" Height="800" MinHeight="680" Width="1320" MinWidth="1140"
        WindowStartupLocation="CenterScreen"
        Background="#EEF3F8"
        FontFamily="Segoe UI"
        FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#152033"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#657084"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LineBrush" Color="#D9E2EE"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#116D6E"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#0B4F50"/>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Background" Value="#F7FAFC"/>
            <Setter Property="BorderBrush" Value="#C9D5E3"/>
        </Style>

        <Style x:Key="BetButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7E1EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FBFD"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F6FA"/>
            <Setter Property="Foreground" Value="#435064"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#D7E1EC"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#EEF3F8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <TabControl Margin="18">
        <TabItem Header="Завдання 1 - перегони">
            <Grid Margin="4,16,4,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="218"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Перегони коней" FontSize="25" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="Потоки, ставки, коефіцієнти та таблиця результатів"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Учасників" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                            <ComboBox x:Name="HorseCountComboBox" Width="76" Margin="0,0,14,0" SelectedIndex="1" SelectionChanged="HorseCountComboBox_SelectionChanged"/>
                            <Button x:Name="StartButton" Content="Старт" Style="{StaticResource PrimaryButton}" Click="StartButton_Click"/>
                            <Button x:Name="ResetButton" Content="Скинути" Style="{StaticResource SecondaryButton}" Click="ResetButton_Click"/>
                            <Button x:Name="NextCameraButton" Content="Камера лідера" ToolTip="Показати рамку камери на коні, який біжить першим" Style="{StaticResource SecondaryButton}" Click="NextCameraButton_Click"/>
                            <Border Background="#E8F6F3" BorderBrush="#BFE2DA" BorderThickness="1" CornerRadius="7" Padding="12,0" Height="40">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="StatusTextBlock" Text="готово до старту" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,16,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="16">
                        <StackPanel x:Name="BetPanel">
                            <TextBlock Text="Ставки" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock x:Name="BalanceTextBlock" Text="Баланс: 250$" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentDarkBrush}" Margin="0,10,0,16"/>

                            <TextBlock Text="Сума ставки" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <Button Content="5$" Tag="5" Style="{StaticResource BetButton}" Click="BetAmountButton_Click"/>
                                <Button Content="10$" Tag="10" Style="{StaticResource BetButton}" Click="BetAmountButton_Click"/>
                                <Button Content="25$" Tag="25" Style="{StaticResource BetButton}" Click="BetAmountButton_Click"/>
                                <Button Content="50$" Tag="50" Style="{StaticResource BetButton}" Click="BetAmountButton_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="SelectedBetTextBlock" Text="Обрано: 10$" FontWeight="SemiBold" Margin="0,0,0,14"/>

                            <TextBlock Text="Кінь" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                            <ComboBox x:Name="BetHorseComboBox" Margin="0,0,0,14"/>

                            <TextBlock Text="Ставка списується після старту. Якщо кінь переможе, ставка множиться на коефіцієнт."
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="12" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="TrackImage" Stretch="Fill"/>
                            <Rectangle Fill="#22000000"/>
                            <Canvas x:Name="RaceCanvas" ClipToBounds="True" SizeChanged="RaceCanvas_SizeChanged">
                                <Rectangle x:Name="StartLine" Width="5" Fill="#F7F7F2" Opacity="0.95"/>
                                <Rectangle x:Name="FinishLine" Width="6" Fill="#E63946" Opacity="0.96"/>
                                <TextBlock x:Name="StartLabel" Text="СТАРТ" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                <TextBlock x:Name="FinishLabel" Text="ФІНІШ" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                <Rectangle x:Name="CameraFrame" Width="118" Height="82" RadiusX="6" RadiusY="6" Stroke="#FFD047" StrokeThickness="4" Fill="#20FFD047" Visibility="Collapsed" IsHitTestVisible="False"/>
                            </Canvas>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="0.95*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="14">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="Поточний стан і коефіцієнти" FontWeight="Bold" FontSize="17" Foreground="{StaticResource InkBrush}"/>
                                <TextBlock Text="коефіцієнти змінюються після гонки" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </Grid>
                            <DataGrid x:Name="HorsesDataGrid" ItemsSource="{Binding HorsesView}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="42">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="13" Height="13" Fill="{Binding Brush}" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Ім'я" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Позиція" Binding="{Binding X, StringFormat=F0}" Width="86"/>
                                    <DataGridTextColumn Header="Прискорення" Binding="{Binding Acceleration, StringFormat=F2}" Width="118"/>
                                    <DataGridTextColumn Header="Час" Binding="{Binding RunTimeText}" Width="95"/>
                                    <DataGridTextColumn Header="Коеф." Binding="{Binding Coefficient, StringFormat=F2}" Width="80"/>
                                    <DataGridTextColumn Header="Виграш" Binding="{Binding Money, StringFormat=F0}" Width="85"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="14">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="Результати" FontWeight="Bold" FontSize="17" Foreground="{StaticResource InkBrush}"/>
                                <TextBlock Text="порядок фінішу" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </Grid>
                            <DataGrid x:Name="ResultsDataGrid" ItemsSource="{Binding Results}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Місце" Binding="{Binding Place}" Width="85"/>
                                    <DataGridTextColumn Header="Кінь" Binding="{Binding HorseName}" Width="*"/>
                                    <DataGridTextColumn Header="Час фінішу" Binding="{Binding FinishTimeText}" Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="Завдання 2 - Вороной">
            <local:VoronoiControl Margin="4,16,4,4"/>
        </TabItem>
    </TabControl>
</Window>
